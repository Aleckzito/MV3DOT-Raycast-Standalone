{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otraycast.local/schemas/manifests/registry_catalog.schema.json",
  "title": "OTRaycast ContentRegistry catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "const": "otraycast.content_registry.catalog.v1" },
    "version": { "type": "integer", "minimum": 1 },
    "notes": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["contentId", "runtimeId", "kind", "status"],
        "properties": {
          "contentId": { "type": "string", "pattern": "^otr\\.[a-z0-9_.]+$" },
          "runtimeId": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "kind": {
            "type": "string",
            "enum": ["item", "actor", "ability", "npc", "quest", "pack"]
          },
          "status": {
            "type": "string",
            "enum": ["active", "design_stub", "planned", "reserved_canary", "blocked_unused"]
          },
          "displayName": { "type": "string" },
          "definitionPath": { "type": "string" },
          "externalAliases": { "type": "array" }
        }
      }
    }
  }
}
