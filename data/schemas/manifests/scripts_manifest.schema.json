{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otraycast.local/schemas/manifests/scripts_manifest.schema.json",
  "title": "OTRaycast Luau scripts manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "scripts"],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["otraycast.scripts.manifest.v1", "otraycast.scripts.registry.v1"]
    },
    "version": { "type": "integer", "minimum": 1 },
    "note": { "type": "string" },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "type"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "pattern": "^data/scripts/.+\\.luau$"
          },
          "type": {
            "type": "string",
            "enum": [
              "lib",
              "action",
              "creaturescript",
              "eventcallback",
              "globalevent",
              "talkaction",
              "movement",
              "weapon"
            ]
          },
          "enabled": { "type": "boolean" },
          "phase": { "type": "integer", "minimum": 1, "maximum": 8 },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
